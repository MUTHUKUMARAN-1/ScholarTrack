# ScholarTrack Configuration
# Application
PROJECT_NAME="ScholarTrack API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Database: SQLite for zero-config local dev; PostgreSQL for production
DATABASE_URL="sqlite:///./scholartrack.db"
# Example PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scholartrack"

# Security & Admin Authentication
SECRET_KEY="replace-with-a-unique-random-secret-at-least-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-unique-password"

# Background Collection Scheduler
SCHEDULER_ENABLED=True
DEFAULT_COLLECTION_INTERVAL_MINUTES=60
